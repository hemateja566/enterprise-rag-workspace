# ============================================================
# Enterprise RAG Workspace - Docker Environment Variables
# ============================================================
# Copy to .env and fill in real values before running `docker compose up`

# === MySQL Database ===
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=enterprise_rag
MYSQL_USER=rag_user
MYSQL_PASSWORD=rag_password

# === MySQL Connection URI (used by Flask API) ===
# Format: mysql+pymysql://rag_user:rag_password@mysql:3306/enterprise_rag
MYSQL_URI=mysql+pymysql://rag_user:rag_password@mysql:3306/enterprise_rag

# === Redis (Celery broker & result backend) ===
REDIS_URL=redis://redis:6379/0

# === Flask / JWT Security ===
# Generate secure values: openssl rand -hex 32
SECRET_KEY=change-this-to-a-really-random-string
JWT_SECRET_KEY=change-this-also-to-a-really-random-string

# === Embedding Configuration ===
# Supported: text-embedding-3-large (OpenAI), sentence-transformers (local)
DEFAULT_EMBEDDING_MODEL=text-embedding-3-large

# Vector store backend: chromadb, faiss_local, or mock
VECTOR_BACKEND=chromadb

# === Celery Configuration ===
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# === Frontend Configuration ===
# API URL as seen by the React frontend
REACT_APP_API_URL=http://localhost:5000/api

# === Application Limits ===
# Max document size in bytes (default: 50MB)
MAX_DOCUMENT_SIZE=52428800

# Chunking parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50